# Tencent Lighthouse / Node.js runtime
DATABASE_PATH=.data/typetiger.sqlite
LOCAL_UPLOAD_PATH=.data/uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-value

# Tencent Cloud COS (server-side only)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=
